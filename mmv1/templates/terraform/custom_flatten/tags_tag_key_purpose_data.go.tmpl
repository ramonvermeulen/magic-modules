func flatten{{$.GetPrefix}}{{$.TitlelizeProperty}}(v interface{}, d *schema.ResourceData, config *transport_tpg.Config) interface{} {
	if v == nil {
		return nil
	}
	original := v.(map[string]interface{})
	if len(original) == 0 {
		return nil
	}
	transformed := make(map[string]interface{})
	for k, val := range original {
		transformed[k] = val
	}
	// `network` is returned by the API in its canonical self-link-with-id form
	// (https://www.googleapis.com/compute/{compute_version}/projects/{projectId}/global/networks/{networkId}).
	// Store that value verbatim rather than the user's original short form so that reads are
	// idempotent; legacy states in the short form are converted by the resource's state upgrader.
	return transformed
}
